<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="es.logongas.fpempresa.modelo.empresa.DominioConocido" table="dominioconocido"  >
        <id name="idDominioConocido" >
            <generator class="identity" />
        </id>

        <property name="dominio" />

        <property name="tipoDominioConocido" >
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">es.logongas.fpempresa.modelo.empresa.TipoDominioConocido</param>
                <param name="type">12</param>
            </type>    
        </property> 


        <property name="fechaAlta" update="false" />

        
    </class>
</hibernate-mapping>
